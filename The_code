import random as rn

choices = ['rock', 'paper', 'scissors']
user_score = 0
computer_score = 0

def game(user, computer):
    global user_score
    global computer_score
    print(f'You chose {user}, computer chose {computer}.')
    
    if user == computer:
        print(f"Both players selected {user}. It's a tie!\n")
    elif user == 'rock':
        if computer == 'scissors':
            user_score += 1
            print(f'Rock smashes scissors! You scored 1 point. Your score: {user_score}, Computer score: {computer_score}\n')
        else:
            computer_score += 1
            print(f'Paper covers rock! Computer scored 1 point. Your score: {user_score}, Computer score: {computer_score}\n')
    elif user == 'paper':
        if computer == 'rock':
            user_score += 1
            print(f'Paper covers rock! You scored 1 point. Your score: {user_score}, Computer score: {computer_score}\n')
        else:
            computer_score += 1
            print(f'Scissors cuts paper! Computer scored 1 point. Your score: {user_score}, Computer score: {computer_score}\n')
    elif user == 'scissors':
        if computer == 'paper':
            user_score += 1
            print(f'Scissors cuts paper! You scored 1 point. Your score: {user_score}, Computer score: {computer_score}\n')
        else:
            computer_score += 1
            print(f'Rock smashes scissors! Computer scored 1 point. Your score: {user_score}, Computer score: {computer_score}\n')

while True:
    if user_score == 10:
        print('='*30 + '\n YOUR SCORE REACHED 10. YOU WIN! \n' + '='*30)
        break
    elif computer_score == 10:
        print('='*30 + '\n COMPUTER SCORE REACHED 10. COMPUTER WINS! \n' + '='*30)
        break

    user_choice = input('Enter a choice (rock, paper, scissors): ').lower()
    computer_choice = rn.choice(choices)

    if user_choice == 'quitgame':
        print('FINISH')
        break
    elif user_choice not in choices:
        print('You chose a wrong choice, please try again')
    else:
        game(user_choice, computer_choice)
